APP_ENV=development

GEMINI_API_KEY=
# Free-tier Flash model id (verified 2026-11-22). gemini-2.5-flash is closed to new keys; 3.7/3.8-flash often return 503 high demand.
GEMINI_MODEL=gemini-3.6-flash

NOTION_API_KEY=
# Data source id (Notion API 2025-09-03), NOT the database id - see docs/NOTION_SETUP.md.
NOTION_DATA_SOURCE_ID=

# Optional Claude fallback (ADR-012): used only when Gemini is rate limited or down. Leave empty to disable.
ANTHROPIC_API_KEY=
# Optional; default claude-haiku-5-5 (cheap and fast; e.g. claude-sonnet-5-5 for higher quality).
CLAUDE_MODEL=
